<%- include('../partials/header') %>
<div class="row g-4">
  <div class="col-lg-6">
    <div class="card p-4 h-100">
      <h2 class="mb-3">Vernacular AI learning assistant</h2>
      <form method="POST" action="/assistant">
        <div class="mb-3">
          <label class="form-label">Ask a question in <%= user.preferredLanguage || 'Bengali' %></label>
          <textarea class="form-control" name="question" rows="4" placeholder="What should I learn next?"><%= question %></textarea>
        </div>
        <button class="btn btn-primary">Ask assistant</button>
      </form>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card p-4 h-100">
      <h3>Answer</h3>
      <div class="alert alert-info">
        <strong>Language:</strong> <%= response.language %>
      </div>
      <p><%= response.answer %></p>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
