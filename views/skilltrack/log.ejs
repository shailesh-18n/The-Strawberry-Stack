<%- include('../partials/header') %>
<div class="mb-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div>
      <p class="text-primary fw-semibold mb-1">SkillTrack • Git-inspired Learning History</p>
      <h1>Learning progress</h1>
      <p class="lead mb-0">Record milestones, track assessments as commits, compare skill diffs, and inspect your learning history.</p>
    </div>
    <div class="text-md-end">
      <span class="badge bg-dark px-3 py-2 fs-6">
        <span class="text-muted">Repo:</span> <%= user.name %> (<%= user.email %>)
      </span>
    </div>
  </div>
</div>

<% if (saved) { %>
  <div class="alert alert-success" role="status">Your learning milestone was saved.</div>
<% } %>
<% if (error) { %>
  <div class="alert alert-danger" role="alert"><%= error %></div>
<% } %>

<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <section class="card h-100 p-3">
      <h2 class="h6">Milestones logged</h2>
      <p class="display-6 mb-0"><%= entries.length %></p>
    </section>
  </div>
  <div class="col-12 col-md-4">
    <section class="card h-100 p-3">
      <h2 class="h6">Coding assessment records</h2>
      <p class="display-6 mb-0"><%= assessmentProgress.length %></p>
    </section>
  </div>
  <div class="col-12 col-md-4">
    <section class="card h-100 p-3">
      <h2 class="h6">Offline lessons completed</h2>
      <p class="display-6 mb-0"><%= lessonProgress.length %></p>
    </section>
  </div>
</div>

<section class="card p-4 mb-4" aria-labelledby="milestone-form-title">
  <h2 class="h4" id="milestone-form-title">Log a learning milestone</h2>
  <p class="text-muted">Create a learning record (commit) on your learning path. These level updates are self-reported learning notes, not a verified credential.</p>
  <form method="POST" action="/skilltrack" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row g-3">
      <div class="col-12 col-md-6">
        <label class="form-label" for="skill-id">Skill</label>
        <select class="form-select" id="skill-id" name="skillId" required>
          <option value="">Choose a skill</option>
          <% skills.forEach((skill) => { %>
            <option value="<%= skill._id %>" <%= form.skillId === String(skill._id) ? 'selected' : '' %>><%= skill.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label" for="current-level">Current level</label>
        <select class="form-select" id="current-level" name="currentLevel" required>
          <option value="">Choose a level</option>
          <% levels.forEach((level) => { %>
            <option value="<%= level %>" <%= form.currentLevel === level ? 'selected' : '' %>><%= level.charAt(0).toUpperCase() + level.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label" for="branch-name">Branch (Career / Learning Path)</label>
        <select class="form-select" id="branch-name" name="branch">
          <% (branches || ['main']).forEach((b) => { %>
            <option value="<%= b %>" <%= (form.branch || 'main') === b ? 'selected' : '' %>> <%= b %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label" for="tag-name">Milestone Tag (Optional)</label>
        <input class="form-control" id="tag-name" name="tag" maxlength="50" value="<%= form.tag || '' %>" placeholder="e.g. v1.0-milestone">
      </div>
      <div class="col-12">
        <label class="form-label" for="commit-message">Milestone title</label>
        <input class="form-control" id="commit-message" name="commitMessage" minlength="3" maxlength="100" required value="<%= form.commitMessage || '' %>" placeholder="For example: Built my first responsive page">
      </div>
      <div class="col-12">
        <label class="form-label" for="change-summary">What changed?</label>
        <textarea class="form-control" id="change-summary" name="changeSummary" rows="3" minlength="3" maxlength="500" required><%= form.changeSummary || '' %></textarea>
      </div>
    </div>
    <button class="btn btn-primary mt-3" type="submit">Save milestone</button>
  </form>
</section>

<section class="card p-4 mb-4" aria-labelledby="milestone-history-title">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div>
      <h2 class="h4 mb-0" id="milestone-history-title">Your milestones</h2>
      <p class="text-muted small mb-0">Git log • Append-only historical learning commits</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="small fw-semibold text-muted">Branch:</span>
      <div class="btn-group btn-group-sm" role="group" aria-label="Branch filter">
        <a href="/skilltrack?branch=all" class="btn <%= selectedBranch === 'all' ? 'btn-dark' : 'btn-outline-dark' %>">All</a>
        <% (branches || ['main']).forEach((b) => { %>
          <a href="/skilltrack?branch=<%= b %>" class="btn <%= selectedBranch === b ? 'btn-dark' : 'btn-outline-dark' %>"> <%= b %></a>
        <% }) %>
      </div>
    </div>
  </div>

  <% if (entries.length) { %>
    <ol class="list-group list-group-numbered">
      <% entries.forEach((entry) => { %>
        <li class="list-group-item p-3 mb-2 border rounded">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <div>
              <span class="badge bg-secondary font-monospace">commit <%= entry.commitHash || String(entry._id).slice(0, 8) %></span>
              <span class="badge bg-light text-dark border"> <%= entry.branch || 'main' %></span>
              <% if (entry.tag) { %>
                <span class="badge bg-primary">🏷️ <%= entry.tag %></span>
              <% } %>
              <% if (entry.isVerified) { %>
                <span class="badge bg-success">✓ Verified Assessment</span>
              <% } else if (entry.entryType === 'assessment') { %>
                <span class="badge bg-warning text-dark">Assessment Attempt</span>
              <% } else { %>
                <span class="badge bg-info text-dark">Self-reported Milestone</span>
              <% } %>
            </div>
            <div>
              <% if (entry.status === 'improved') { %>
                <span class="badge bg-success-subtle text-success border border-success">▲ <%= entry.diff || 'Improved' %></span>
              <% } else if (entry.status === 'regressed') { %>
                <span class="badge bg-danger-subtle text-danger border border-danger">▼ <%= entry.diff || 'Regressed' %></span>
              <% } else if (entry.status === 'unchanged') { %>
                <span class="badge bg-light text-secondary border">■ <%= entry.diff || 'Unchanged' %></span>
              <% } else if (entry.diff) { %>
                <span class="badge bg-info-subtle text-info border border-info">★ <%= entry.diff %></span>
              <% } %>
            </div>
          </div>
          <h3 class="h6 mb-1 text-dark fw-bold"><%= entry.commitMessage %></h3>
          <p class="mb-1 text-secondary">
            <strong><%= entry.skill ? entry.skill.name : 'Skill' %>:</strong>
            <span class="text-capitalize"><%= entry.previousLevel %></span> to <span class="text-capitalize"><%= entry.currentLevel %></span>
            <% if (entry.score != null) { %>
              • <strong>Score:</strong> <%= entry.score %>%
              <% if (entry.scoreDelta != null && entry.scoreDelta !== 0) { %>
                (<%= entry.scoreDelta > 0 ? '+' : '' %><%= entry.scoreDelta %>%)
              <% } %>
            <% } %>
          </p>
          <p class="mb-2"><%= entry.changeSummary %></p>
          <div class="d-flex align-items-center justify-content-between text-muted small">
            <span>Author: <strong><%= user.name %></strong></span>
            <time datetime="<%= entry.createdAt.toISOString() %>"><%= entry.createdAt.toLocaleString() %></time>
          </div>
        </li>
      <% }) %>
    </ol>
    <% if (entries.length === 50) { %><p class="small text-muted mt-2 mb-0">Showing the latest 50 milestones.</p><% } %>
  <% } else { %>
    <p class="text-muted mb-0">No milestones yet. Add a learning update above to start your history.</p>
  <% } %>
</section>

<div class="row g-4">
  <div class="col-12 col-lg-6">
    <section class="card h-100 p-4" aria-labelledby="assessment-history-title">
      <h2 class="h4" id="assessment-history-title">Coding assessment progress</h2>
      <% if (assessmentProgress.length) { %>
        <ul class="list-group list-group-flush">
          <% assessmentProgress.forEach((record) => { %>
            <li class="list-group-item px-0">
              <strong><%= record.skill ? record.skill.name : 'Coding Skill' %></strong> — <%= record.passed ? 'Passed' : 'Needs practice' %> (<%= record.score %>%)
              <time class="d-block small text-muted" datetime="<%= record.createdAt.toISOString() %>"><%= record.createdAt.toLocaleString() %></time>
            </li>
          <% }) %>
        </ul>
      <% } else { %><p class="text-muted mb-0">Coding assessment results will appear here.</p><% } %>
    </section>
  </div>
  <div class="col-12 col-lg-6">
    <section class="card h-100 p-4" aria-labelledby="lesson-history-title">
      <h2 class="h4" id="lesson-history-title">Offline lesson progress</h2>
      <% if (lessonProgress.length) { %>
        <ul class="list-group list-group-flush">
          <% lessonProgress.forEach((record) => { %>
            <li class="list-group-item px-0">
              <strong><%= record.skill ? record.skill.name : 'Lesson' %></strong> completed
              <time class="d-block small text-muted" datetime="<%= record.completedAt.toISOString() %>"><%= record.completedAt.toLocaleString() %></time>
            </li>
          <% }) %>
        </ul>
      <% } else { %><p class="text-muted mb-0">Synced offline lesson completions will appear here.</p><% } %>
    </section>
  </div>
</div>
<%- include('../partials/footer') %>
