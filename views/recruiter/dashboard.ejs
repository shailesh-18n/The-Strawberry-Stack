<%- include('../partials/header') %>
<div class="card p-4">
  <p class="text-primary fw-semibold mb-1">Recruiter dashboard</p>
  <h1>Verified student profile</h1>
  <p>Recruiters can verify credentials using the student’s QR code or verification ID.</p>
  <div class="mt-3">
    <form method="GET" action="/verify/preview">
      <div class="input-group">
        <input class="form-control" name="verificationId" placeholder="Enter credential ID" />
        <button class="btn btn-primary" type="submit">Verify</button>
      </div>
    </form>
  </div>
  <div class="mt-4">
    <h4>Sample shared data</h4>
    <ul>
      <li>Verified skill milestones</li>
      <li>Assessment summary</li>
      <li>Learning progression</li>
    </ul>
  </div>
</div>
<%- include('../partials/footer') %>
