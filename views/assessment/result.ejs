<%- include('../partials/header') %>
<div class="card p-4">
  <p class="text-primary fw-semibold mb-1">Assessment result</p>
  <h1><%= result.success ? 'Assessment passed' : 'Needs revision' %></h1>
  <p class="lead"><%= result.message %></p>
  <div class="mb-3">
    <strong>Challenge:</strong> <%= challengeId %><br />
    <strong>Passed tests:</strong> <%= result.totalTests ? result.passedTests + '/' + result.totalTests : '0' %>
  </div>
  <div class="mb-3">
    <strong>SkillTrack:</strong> <%= progress.commitMessage %>
  </div>
  <% if (credential && qrDataUrl) { %>
    <div class="row align-items-center">
      <div class="col-md-8">
        <h4>Credential issued</h4>
        <p><strong>Skill:</strong> <%= credential.skillName %></p>
        <p><strong>Issuer:</strong> <%= credential.issuer %></p>
      </div>
      <div class="col-md-4 text-center">
        <img src="<%= qrDataUrl %>" alt="Credential QR code" class="img-fluid" style="max-width: 180px;" />
      </div>
    </div>
  <% } %>
  <a href="/skilltrack" class="btn btn-primary mt-3">View SkillTrack</a>
</div>
<%- include('../partials/footer') %>
