<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <p class="text-primary fw-semibold mb-1">Career navigator</p>
    <h1 class="mb-0">Skill gap analysis</h1>
  </div>
  <form method="POST" action="/career/recommend">
    <button class="btn btn-primary">Refresh recommendation</button>
  </form>
</div>

<div class="card p-4 mb-4">
  <h3><%= recommendation.career.name %></h3>
  <p><%= recommendation.career.description %></p>
  <div>
    <% (recommendation.career.skills || []).forEach((skill) => { %>
      <span class="skill-pill"><%= skill %></span>
    <% }) %>
  </div>
  <div class="mt-3">
    <strong>Missing skills:</strong> <%= recommendation.missingSkills.length ? recommendation.missingSkills.join(', ') : 'No major gaps identified.' %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card p-4 h-100">
      <h4>Roadmap</h4>
      <ol>
        <% (recommendation.roadmap || []).forEach((step) => { %>
          <li class="mb-2"><%= step %></li>
        <% }) %>
      </ol>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="card p-4 h-100">
      <h4>Available career tracks</h4>
      <% careers.forEach((career) => { %>
        <div class="card p-3 mb-3 bg-light">
          <h5><%= career.name %></h5>
          <p class="mb-2"><%= career.description %></p>
          <div>
            <% (career.skills || []).forEach((skill) => { %>
              <span class="skill-pill"><%= skill %></span>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
