<%- include('../partials/header') %>
<section class="hero">
  <p class="text-primary fw-semibold mb-2">Student dashboard</p>
  <h1 class="display-6 fw-bold">Welcome, <%= user.name %></h1>
  <p class="lead mb-4">Your profile is saved. Keep your learning goals and preferences up to date.</p>
  <a class="btn btn-primary" href="/profile">View or update your profile</a>
  <a class="btn btn-outline-primary ms-2" href="/career">Explore the Skill Graph</a>
  <a class="btn btn-outline-primary ms-2" href="/skilltrack">Open SkillTrack</a>
  <a class="btn btn-outline-primary ms-2" href="/credentials">Open Skill Passport</a>
  <a class="btn btn-outline-primary ms-2" href="/opportunities">Match Opportunities</a>
  <a class="btn btn-outline-primary ms-2" href="/portfolio/<%= user._id || user.id %>">View Portfolio</a>
  <a class="btn btn-outline-primary ms-2" href="/assistant">Ask the learning assistant</a>
</section>
<div class="row g-4 mt-2">
  <div class="col-md-6">
    <section class="card h-100 p-4">
      <h2 class="h5">Your preferences</h2>
      <p class="mb-2"><strong>Language:</strong> <%= user.preferredLanguage %></p>
      <p class="mb-2"><strong>Career interests:</strong> <%= (user.aspirations || []).join(', ') || 'Not selected yet' %></p>
      <p class="mb-0"><strong>Learning interests:</strong> <%= (user.interests || []).join(', ') || 'Not added yet' %></p>
    </section>
  </div>
  <div class="col-md-6">
    <section class="card h-100 p-4">
      <h2 class="h5">Profile summary</h2>
      <p class="mb-0"><%= user.profileSummary || 'Add a short introduction to your profile.' %></p>
    </section>
  </div>
</div>
<%- include('../partials/footer') %>
