<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <p class="text-primary fw-semibold mb-1">Student dashboard</p>
    <h1 class="mb-0">Welcome, <%= user.name %></h1>
  </div>
  <a href="/profile" class="btn btn-outline-primary">Edit profile</a>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card p-4 h-100">
      <h5>Profile snapshot</h5>
      <p><strong>Language:</strong> <%= user.preferredLanguage %></p>
      <p><strong>Education:</strong> <%= user.educationLevel %></p>
      <p><strong>Career goal:</strong> <%= user.aspirations.join(', ') || 'Not set' %></p>
      <div>
        <% (user.skillInventory || []).forEach((skill)=>{ %>
          <span class="skill-pill"><%= skill %></span>
        <% }) %>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card p-4">
      <h5>Top career recommendation</h5>
      <h3><%= recommendation.career.name %></h3>
      <p><%= recommendation.career.description %></p>
      <div class="mb-3">
        <% (recommendation.career.skills || []).forEach((skill)=>{ %>
          <span class="skill-pill"><%= skill %></span>
        <% }) %>
      </div>
      <p><strong>Missing skills:</strong> <%= recommendation.missingSkills.length ? recommendation.missingSkills.join(', ') : 'No major gaps detected.' %></p>
      <a href="/career" class="btn btn-primary">See full roadmap</a>
    </div>
  </div>
</div>

<div class="row mt-4 g-4">
  <div class="col-md-6">
    <div class="card p-4">
      <h5>Learning roadmap</h5>
      <ol>
        <% (recommendation.roadmap || []).forEach((step) => { %>
          <li class="mb-2"><%= step %></li>
        <% }) %>
      </ol>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card p-4">
      <h5>Recent SkillTrack updates</h5>
      <% if (history.length) { %>
        <% history.slice(0, 4).forEach((record) => { %>
          <div class="timeline-item">
            <strong><%= record.commitMessage %></strong>
            <div class="text-muted"><%= new Date(record.createdAt).toLocaleString() %></div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-muted">No assessment history yet.</p>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
