<%- include('../partials/header') %>
<div class="card p-4">
  <h1 class="mb-4">Student profile</h1>
  <div class="row g-3">
    <div class="col-md-6"><strong>Name:</strong> <%= user.name %></div>
    <div class="col-md-6"><strong>Email:</strong> <%= user.email %></div>
    <div class="col-md-6"><strong>Preferred language:</strong> <%= user.preferredLanguage %></div>
    <div class="col-md-6"><strong>Education level:</strong> <%= user.educationLevel %></div>
    <div class="col-12"><strong>Interests:</strong> <%= (user.interests || []).join(', ') %></div>
    <div class="col-12"><strong>Career aspirations:</strong> <%= (user.aspirations || []).join(', ') %></div>
    <div class="col-12"><strong>Current skills:</strong> <%= (user.skillInventory || []).join(', ') %></div>
    <div class="col-12"><strong>Learning preferences:</strong> <%= (user.learningPreferences || []).join(', ') %></div>
    <div class="col-12"><strong>Access needs:</strong> <%= (user.accessNeeds || []).join(', ') %></div>
    <div class="col-12"><strong>Summary:</strong> <%= user.profileSummary %></div>
  </div>
</div>
<%- include('../partials/footer') %>
