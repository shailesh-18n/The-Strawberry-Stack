<%- include('partials/header') %>
<div class="hero">
  <div class="row align-items-center g-4">
    <div class="col-lg-7">
      <p class="text-primary fw-semibold mb-2">A learning journey built around you</p>
      <h1 class="display-5 fw-bold">Connect your interests to your learning goals.</h1>
      <p class="lead mt-3">
        Create a student profile with your preferred language, learning interests,
        and career aspirations. You can update your profile as your goals change.
      </p>
      <% if (!user) { %>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <a href="/auth/register" class="btn btn-primary btn-lg">Join as a Student</a>
          <a href="/auth/login" class="btn btn-outline-primary btn-lg">Login</a>
          <a href="/recruiter" class="btn btn-outline-secondary btn-lg">Recruiter Portal</a>
        </div>
      <% } else { %>
        <div class="d-flex gap-3 mt-4">
          <a href="/dashboard" class="btn btn-primary btn-lg">Go to Dashboard</a>
          <a href="/assistant" class="btn btn-outline-primary btn-lg">Ask the AI tutor</a>
        </div>
      <% } %>
    </div>
    <div class="col-lg-5">
      <div class="card p-4">
        <h3 class="mb-3">Get started</h3>
        <ul class="list-group list-group-flush">
        <li class="list-group-item">1. Create your student account</li>
        <li class="list-group-item">2. Choose a preferred language</li>
        <li class="list-group-item">3. Select learning and career interests</li>
        <li class="list-group-item">4. Review or update your profile</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<div class="row mt-5 g-4">
  <div class="col-md-4">
    <div class="card h-100 p-4 shadow-sm border">
      <h2 class="h5 text-primary">Skill Graph & Career Navigator</h2>
      <p class="mb-0 text-muted">Personalized prerequisite-aware roadmaps, SVG dependency graphs, and multilingual (English, Bengali, Hindi, Kannada) AI learning guidance.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 p-4 shadow-sm border">
      <h2 class="h5 text-primary">Git-Inspired SkillTrack & Passport</h2>
      <p class="mb-0 text-muted">Append-only chronological commit log, career-path branches, milestone tagging, and Ed25519 cryptographically signed credentials.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 p-4 shadow-sm border">
      <h2 class="h5 text-primary">Opportunity Matching & Recruiters</h2>
      <p class="mb-0 text-muted">Deterministic skill-gap matching against real internship roles, actionable bridge suggestions, and recruiter verification tools.</p>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
