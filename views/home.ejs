<%- include('partials/header') %>
<div class="hero">
  <div class="row align-items-center g-4">
    <div class="col-lg-7">
      <p class="text-primary fw-semibold mb-2">A learning journey built around you</p>
      <h1 class="display-5 fw-bold">Connect your interests to your learning goals.</h1>
      <p class="lead mt-3">
        Create a student profile with your preferred language, learning interests,
        and career aspirations. You can update your profile as your goals change.
      </p>
      <% if (!user) { %>
        <div class="d-flex gap-3 mt-4">
          <a href="/auth/register" class="btn btn-primary btn-lg">Join as a Student</a>
          <a href="/auth/login" class="btn btn-outline-primary btn-lg">Login</a>
        </div>
      <% } else { %>
        <div class="d-flex gap-3 mt-4">
          <a href="/dashboard" class="btn btn-primary btn-lg">Go to Dashboard</a>
          <a href="/assistant" class="btn btn-outline-primary btn-lg">Ask the AI tutor</a>
        </div>
      <% } %>
    </div>
    <div class="col-lg-5">
      <div class="card p-4">
        <h3 class="mb-3">Get started</h3>
        <ul class="list-group list-group-flush">
        <li class="list-group-item">1. Create your student account</li>
        <li class="list-group-item">2. Choose a preferred language</li>
        <li class="list-group-item">3. Select learning and career interests</li>
        <li class="list-group-item">4. Review or update your profile</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<div class="row mt-5 g-4">
  <div class="col-md-4">
    <div class="card h-100 p-4">
      <h4>Personal learning profile</h4>
      <p>Keep your skills, education, and learning preferences together.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 p-4">
      <h4>Language preferences</h4>
      <p>Choose Bengali or English as your preferred language.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 p-4">
      <h4>Career interests</h4>
      <p>Record the career areas you want to explore.</p>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
