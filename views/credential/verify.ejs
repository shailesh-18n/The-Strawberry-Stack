<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="card p-4 p-md-5 shadow-sm border">
      <div class="d-flex align-items-center gap-2 mb-3">
        <span class="fs-4">🛡️</span>
        <h1 class="h3 mb-0">Credential verification</h1>
      </div>

      <% if (verification && verification.valid) { %>
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
          <span class="fs-5">✓</span>
          <div>
            <strong>Valid cryptographic credential</strong>
            <div class="small">The Ed25519 digital signature and evidence hash chain have been independently verified.</div>
          </div>
        </div>

        <div class="card bg-light p-3 mb-4 border-0">
          <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Student:</dt>
            <dd class="col-sm-8 fw-semibold"><%= verification.credential.studentName %></dd>

            <dt class="col-sm-4 text-muted">Skill:</dt>
            <dd class="col-sm-8"><span class="badge bg-primary fs-6"><%= verification.credential.skillName %></span></dd>

            <dt class="col-sm-4 text-muted">Assessment:</dt>
            <dd class="col-sm-8"><%= verification.credential.assessmentId %></dd>

            <dt class="col-sm-4 text-muted">Assessment result:</dt>
            <dd class="col-sm-8 text-capitalize"><%= verification.credential.assessmentResult %></dd>

            <dt class="col-sm-4 text-muted">Issuer:</dt>
            <dd class="col-sm-8"><%= verification.issuer || 'VidyaChain' %></dd>

            <dt class="col-sm-4 text-muted">Algorithm:</dt>
            <dd class="col-sm-8">Ed25519 (Asymmetric Digital Signature)</dd>

            <dt class="col-sm-4 text-muted">Evidence hash:</dt>
            <dd class="col-sm-8 font-monospace small text-break"><%= verification.hashChain %></dd>

            <dt class="col-sm-4 text-muted">Previous record hash:</dt>
            <dd class="col-sm-8 font-monospace small text-break"><%= verification.previousHash || verification.credential.previousHash || 'genesis' %></dd>

            <dt class="col-sm-4 text-muted">Issued at:</dt>
            <dd class="col-sm-8">
              <%= new Date(verification.credential.createdAt || verification.credential.issuedAt).toLocaleString() %>
            </dd>
          </dl>
        </div>
      <% } else { %>
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
          <span class="fs-5">⚠️</span>
          <div>
            <strong>Credential invalid or unavailable</strong>
            <div class="small"><%= verification ? (verification.reason || 'Cryptographic verification check failed.') : 'No credential provided.' %></div>
          </div>
        </div>
      <% } %>

      <div class="d-flex gap-2 mt-2">
        <a href="/" class="btn btn-outline-secondary">Home</a>
        <% if (user) { %>
          <a href="/credentials" class="btn btn-primary">My Skill Passport</a>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

