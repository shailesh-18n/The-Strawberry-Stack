<%- include('../partials/header') %>
<div class="mb-4">
  <p class="text-primary fw-semibold mb-1">Skill Passport</p>
  <h1>Cryptographic credentials</h1>
</div>

<% if (credentials.length) { %>
  <% credentials.forEach((credential) => { %>
    <div class="card p-4 mb-3">
      <h4><%= credential.skillName %></h4>
      <p><strong>Status:</strong> <span class="badge badge-soft"><%= credential.status %></span></p>
      <p><strong>Assessment:</strong> <%= credential.assessmentId %></p>
      <p><strong>Hash:</strong> <%= credential.evidenceHash %></p>
      <a class="btn btn-outline-primary" href="/verify/<%= credential.id %>">Verify credential</a>
    </div>
  <% }) %>
<% } else { %>
  <div class="card p-4">
    <p class="mb-0">No credentials yet. Pass an assessment to issue your first signed credential.</p>
  </div>
<% } %>
<%- include('../partials/footer') %>
