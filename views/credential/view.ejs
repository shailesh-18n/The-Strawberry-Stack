<%- include('../partials/header') %>
<div class="mb-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div>
      <p class="text-primary fw-semibold mb-1">Skill Passport</p>
      <h1>Cryptographic credentials</h1>
      <p class="lead mb-0">Cryptographically signed, tamper-evident skill credentials verified by VidyaChain Ed25519 digital signatures.</p>
    </div>
    <div>
      <a href="/skilltrack" class="btn btn-outline-primary">Open SkillTrack</a>
      <a href="/career" class="btn btn-outline-secondary ms-1">Explore Careers</a>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <section class="card h-100 p-3">
      <h2 class="h6 text-muted">Total credentials</h2>
      <p class="display-6 mb-0 text-primary"><%= credentials.length %></p>
    </section>
  </div>
  <div class="col-12 col-md-4">
    <section class="card h-100 p-3">
      <h2 class="h6 text-muted">Signature standard</h2>
      <p class="display-6 mb-0 text-success fs-3 mt-1">Ed25519</p>
    </section>
  </div>
  <div class="col-12 col-md-4">
    <section class="card h-100 p-3">
      <h2 class="h6 text-muted">Hash chain status</h2>
      <p class="display-6 mb-0 text-info fs-3 mt-1">Tamper-evident</p>
    </section>
  </div>
</div>

<% if (credentials.length) { %>
  <div class="row g-4">
    <% credentials.forEach((credential) => { %>
      <% const credId = credential._id || credential.id; %>
      <div class="col-12 col-lg-6">
        <div class="card h-100 p-4 shadow-sm border">
          <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
              <span class="badge bg-success-subtle text-success border border-success mb-2">
                ✓ <%= credential.status === 'verified' ? 'Cryptographically Verified' : credential.status %>
              </span>
              <h2 class="h4 mb-1 text-dark"><%= credential.skillName %></h2>
              <p class="text-muted small mb-0">Issuer: <strong><%= credential.issuer || 'VidyaChain' %></strong></p>
            </div>
            <% if (credential.qrCode) { %>
              <div class="text-center">
                <img src="<%= credential.qrCode %>" alt="Verification QR Code" class="img-thumbnail" style="width: 100px; height: 100px;">
                <span class="d-block text-muted" style="font-size: 0.7rem;">Scan to verify</span>
              </div>
            <% } %>
          </div>

          <div class="bg-light p-3 rounded mb-3 small font-monospace">
            <div class="mb-1 text-truncate">
              <strong class="text-secondary">Assessment:</strong> <%= credential.assessmentId %>
            </div>
            <div class="mb-1 text-truncate">
              <strong class="text-secondary">Evidence Hash:</strong> <span title="<%= credential.evidenceHash %>"><%= credential.evidenceHash %></span>
            </div>
            <div class="mb-1 text-truncate">
              <strong class="text-secondary">Previous Hash:</strong> <span title="<%= credential.previousHash %>"><%= credential.previousHash %></span>
            </div>
            <div class="text-truncate">
              <strong class="text-secondary">Signature:</strong> <span class="text-muted"><%= (credential.signature || '').slice(0, 32) %>...</span>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
            <time class="text-muted small" datetime="<%= (credential.createdAt || new Date()).toISOString() %>">
              Issued: <%= (credential.createdAt || new Date()).toLocaleDateString() %>
            </time>
            <a class="btn btn-outline-primary btn-sm" href="/verify/<%= credId %>">
              Verify credential
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="card p-5 text-center">
    <div class="mb-3">
      <span class="fs-1">🎓</span>
    </div>
    <h2 class="h4">No credentials yet</h2>
    <p class="text-muted mx-auto" style="max-width: 500px;">
      Pass an assessment to issue your first signed credential. Once earned, your achievements are cryptographically signed using Ed25519 and chained to your passport.
    </p>
    <div>
      <a href="/assessment" class="btn btn-primary">Take a skill assessment</a>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
