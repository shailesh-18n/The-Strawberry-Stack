<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card p-4 p-md-5">
      <p class="text-primary fw-semibold mb-2">Student onboarding</p>
      <h1 class="h2 mb-2">Create your student profile</h1>
      <p class="text-secondary mb-4">Set up your account and tell us how you want to learn.</p>
      <% if (error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>
      <form method="POST" action="/auth/register">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="name">Full name</label>
            <input class="form-control" id="name" name="name" autocomplete="name" minlength="2" maxlength="80" required value="<%= formData.name || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="email">Email</label>
            <input class="form-control" id="email" type="email" name="email" autocomplete="email" maxlength="254" required value="<%= typeof formData.email === 'string' ? formData.email : '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="password">Password</label>
            <input class="form-control" id="password" type="password" name="password" autocomplete="new-password" minlength="10" maxlength="72" required>
            <div class="form-text">Use at least 10 characters. Passwords are limited to 72 UTF-8 bytes.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="preferredLanguage">Preferred language</label>
            <select class="form-select" id="preferredLanguage" name="preferredLanguage" required>
              <% languages.forEach((language) => { %>
                <option value="<%= language %>" <%= (formData.preferredLanguage || 'Bengali') === language ? 'selected' : '' %>><%= language %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="interests">Learning interests</label>
            <input class="form-control" id="interests" name="interests" maxlength="800" value="<%= (formData.interests || []).join(', ') %>" aria-describedby="interests-help">
            <div class="form-text" id="interests-help">Separate interests with commas.</div>
          </div>
          <div class="col-12">
            <fieldset aria-describedby="career-help">
              <legend class="form-label">Career interests</legend>
              <% careerOptions.forEach((career, index) => { %>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" id="career-<%= index %>" type="checkbox" name="aspirations" value="<%= career %>" <%= (formData.aspirations || []).includes(career) ? 'checked' : '' %>>
                  <label class="form-check-label" for="career-<%= index %>"><%= career %></label>
                </div>
              <% }) %>
              <div class="form-text" id="career-help">Select the careers you would like to explore.</div>
            </fieldset>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="educationLevel">Education level</label>
            <input class="form-control" id="educationLevel" name="educationLevel" maxlength="80" value="<%= formData.educationLevel || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="skillInventory">Current skills</label>
            <input class="form-control" id="skillInventory" name="skillInventory" maxlength="800" value="<%= (formData.skillInventory || []).join(', ') %>">
          </div>
          <div class="col-12">
            <label class="form-label" for="learningPreferences">Learning preferences</label>
            <input class="form-control" id="learningPreferences" name="learningPreferences" maxlength="800" value="<%= (formData.learningPreferences || []).join(', ') %>" aria-describedby="learning-help">
            <div class="form-text" id="learning-help">Separate preferences with commas.</div>
          </div>
          <div class="col-12">
            <label class="form-label" for="accessNeeds">Access needs</label>
            <input class="form-control" id="accessNeeds" name="accessNeeds" maxlength="800" value="<%= (formData.accessNeeds || []).join(', ') %>">
          </div>
          <div class="col-12">
            <label class="form-label" for="profileSummary">About you</label>
            <textarea class="form-control" id="profileSummary" name="profileSummary" rows="3" maxlength="1000"><%= formData.profileSummary || '' %></textarea>
          </div>
        </div>
        <button class="btn btn-primary w-100 mt-4" type="submit">Create account</button>
      </form>
      <p class="mt-3 mb-0 text-center">Already registered? <a href="/auth/login">Log in</a></p>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
